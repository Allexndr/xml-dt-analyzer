# Переменные окружения сервиса. Скопируйте в .env.local (он не попадает в Git) или задайте в Vercel/Docker.

# ИИ (необязательно: без ключа работает режим «без ИИ»)
XMLDT_OPENAI_API_KEY=
# XMLDT_DEFAULT_MODEL=gpt-5.4-mini

# База данных: Postgres (Neon и т. п.). Без неё используется SQLite/файлы в XMLDT_VAR.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Вход по e-mail (коды приходят письмом) и экспертная проверка
# XMLDT_SMTP_HOST=
# XMLDT_SMTP_PORT=587
# XMLDT_SMTP_USER=
# XMLDT_SMTP_PASSWORD=
# XMLDT_SMTP_FROM=
# XMLDT_REVIEWERS=expert1@example.com,expert2@example.com

# Только для локальной разработки, НИКОГДА на проде:
# XMLDT_AUTH_DEV=1
# XMLDT_AUTH_DEV_ECHO=1
